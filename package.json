{
  "name": "devtoolbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://YuChuanhui3.github.io/devtoolbox/",
  "license": "MIT",
  "description": "开发者在线工具箱 · 纯前端、本地优先的一站式工具站",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite-node scripts/render-routes.ts",
    "build:ghpages": "tsc -b && vite-node scripts/gen-sitemap.ts && vite build --base=/devtoolbox/ && ROUTE_BASE=/devtoolbox vite-node scripts/render-routes.ts",
    "sitemap": "vite-node scripts/gen-sitemap.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.5",
    "@noble/hashes": "^2.4.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "crypto-js": "^4.1.1",
    "diff": "^8.0.2",
    "dompurify": "^3.2.4",
    "fast-xml-parser": "^5.2.2",
    "highlight.js": "^11.11.1",
    "js-beautify": "^2.0.3",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.3.0",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.7",
    "node-forge": "^1.4.0",
    "papaparse": "^5.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sql-formatter": "^15.5.0",
    "terser": "^5.51.2",
    "ua-parser-js": "^2.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.3",
    "apache-md5": "^1.1.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
