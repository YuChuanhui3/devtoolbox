{
  "name": "devtoolbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://YuChuanhui3.github.io/devtoolbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuChuanhui3/devtoolbox.git"
  },
  "license": "(MIT AND AGPL-3.0-only)",
  "description": "开发者在线工具箱 · 纯前端、本地优先的一站式工具站",
  "scripts": {
    "dev": "npm run prepare:native && vite",
    "dev:lan": "npm run prepare:native && vite --host 0.0.0.0",
    "start:lan": "node scripts/lan-server.mjs",
    "build": "npm run prepare:native && tsc -b && vite build && vite-node scripts/render-routes.ts",
    "build:single": "npm run prepare:native && tsc -b && vite build --config vite.config.single.ts && vite-node scripts/inline-single.ts",
    "zip:single": "rm -f DevToolbox-offline.zip && zip -9 -j -q DevToolbox-offline.zip dist-single/DevToolbox.html",
    "build:ghpages": "npm run prepare:native && tsc -b && vite-node scripts/gen-sitemap.ts && vite build --base=/devtoolbox/ && ROUTE_BASE=/devtoolbox vite-node scripts/render-routes.ts",
    "sitemap": "vite-node scripts/gen-sitemap.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "prepare:native": "node scripts/prepare-native-workspaces.mjs",
    "test:native:pdf": "vitest run --config scripts/native-workspaces.vitest.config.mjs",
    "test:native:whiteboard": "node --test tests/native/whiteboard/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/poppins": "^5.2.5",
    "@fontsource/roboto-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "crypto-js": "^4.1.1",
    "diff": "^8.0.2",
    "dompurify": "^3.2.4",
    "fast-xml-parser": "^5.2.2",
    "highlight.js": "^11.11.1",
    "js-beautify": "^2.0.3",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.3.0",
    "jsqr": "^1.4.0",
    "lucide": "^1.45.0",
    "lucide-react": "^0.511.0",
    "marked": "^15.0.7",
    "mqtt": "^5.16.1",
    "node-forge": "^1.4.0",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "socket.io-client": "^4.8.4",
    "sql-formatter": "^15.5.0",
    "terser": "^5.51.2",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "ua-parser-js": "^2.0.3",
    "ws": "^8.22.1",
    "yjs": "^13.6.33",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.3",
    "apache-md5": "^1.1.8",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
